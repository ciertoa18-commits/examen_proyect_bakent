{
  "info": {
    "name": "EquipAndes - Anexo B y SC-A a SC-D",
    "description": "Ejecutar carpeta Anexo B sobre esquema recién sembrado. El caso 503 se ejecuta aparte, con Oracle detenido. Los IDs se resuelven por código. Las fechas se calculan con America/Lima.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "fechaInicio",
      "value": "",
      "type": "string"
    },
    {
      "key": "ayer",
      "value": "",
      "type": "string"
    },
    {
      "key": "periodo",
      "value": "",
      "type": "string"
    },
    {
      "key": "alquilerPrincipal",
      "value": "",
      "type": "string"
    },
    {
      "key": "alquilerSemanal",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now=new Date(); const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Lima',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(now); const get=t=>parts.find(p=>p.type===t).value; const today=get('year')+'-'+get('month')+'-'+get('day'); const f=new Date(today+'T12:00:00Z'); f.setUTCDate(f.getUTCDate()+7);pm.collectionVariables.set('fechaInicio',f.toISOString().slice(0,10));const a=new Date(today+'T12:00:00Z');a.setUTCDate(a.getUTCDate()-1);pm.collectionVariables.set('ayer',a.toISOString().slice(0,10));pm.collectionVariables.set('periodo',today.slice(0,7));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Anexo B - ejecutar completo en orden",
      "item": [
        {
          "name": "00 - Preparar fechas y resolver IDs de equipos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/equipos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const datos=pm.response.json();for(const e of datos)pm.collectionVariables.set(e.codigo,e.id);",
                  "pm.test('12 equipos semilla',()=>pm.expect(datos.length).to.eql(12));"
                ]
              }
            }
          ]
        },
        {
          "name": "00 - Resolver IDs de clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "for(const c of pm.response.json())pm.collectionVariables.set(c.codigo,c.id);"
                ]
              }
            }
          ]
        },
